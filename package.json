{
  "name": "neosmartuxui",
  "version": "0.0.0",
  "private": true,
  "description": "NeoSmartUXUI \u00c3\u00a2\u00e2\u201a\u00ac\u00e2\u20ac\u009d the AI-first neo-brutalist UI system.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:foundation": "node tooling/validators/validate-foundation.mjs",
    "validate:spec": "node tooling/validators/validate-spec-architecture.mjs",
    "validate:schemas": "node tooling/validators/validate-schemas.mjs",
    "validate:component-preview-contract": "node tooling/validators/validate-component-preview-contract.mjs",
    "validate:studio-contract": "node tooling/validators/validate-studio-contract.mjs",
    "validate:studio-theme-package": "node tooling/validators/validate-studio-theme-package.mjs",
    "validate:studio-runtime": "node tooling/validators/validate-studio-runtime.mjs",
    "validate:migration": "node tooling/validators/validate-migration.mjs",
    "validate:tokens": "node tooling/validators/validate-core-tokens.mjs",
    "validate:components": "node tooling/validators/validate-core-components.mjs",
    "validate:flavors": "node tooling/validators/validate-flavors.mjs",
    "validate:hardline": "node tooling/validators/validate-hardline-theme.mjs",
    "validate:hardline-dark-contract": "node tooling/validators/validate-hardline-dark-contract.mjs",
    "validate:hardline-dark": "node tooling/validators/validate-hardline-dark-theme.mjs",
    "validate:soft": "node tooling/validators/validate-soft-theme.mjs",
    "validate:soft-dark-contract": "node tooling/validators/validate-soft-dark-contract.mjs",
    "validate:soft-dark": "node tooling/validators/validate-soft-dark-theme.mjs",
    "validate:rivet-contract": "node tooling/validators/validate-rivet-contract.mjs",
    "validate:rivet-dark-contract": "node tooling/validators/validate-rivet-dark-contract.mjs",
    "validate:rivet-dark": "node tooling/validators/validate-rivet-dark-theme.mjs",
    "validate:rivet": "node tooling/validators/validate-rivet-theme.mjs",
    "validate:mono-contract": "node tooling/validators/validate-mono-contract.mjs",
    "validate:mono-dark-contract": "node tooling/validators/validate-mono-dark-contract.mjs",
    "validate:mono-dark": "node tooling/validators/validate-mono-dark-theme.mjs",
    "validate:mono": "node tooling/validators/validate-mono-theme.mjs",
    "validate:resolution": "npm run validate:flavors && node tooling/validators/validate-theme-resolution.mjs && npm run validate:hardline && npm run validate:hardline-dark-contract && npm run validate:hardline-dark && npm run validate:soft && npm run validate:soft-dark-contract && npm run validate:soft-dark && npm run validate:rivet-contract && npm run validate:rivet-dark-contract && npm run validate:rivet-dark && npm run validate:rivet && npm run validate:mono-contract && npm run validate:mono-dark-contract && npm run validate:mono-dark && npm run validate:mono && npm run validate:pulse && npm run validate:pulse-dark && npm run validate:pulse-proof",
    "validate:accessibility": "node tooling/validators/validate-theme-status-contrast.mjs && node tooling/validators/validate-reduced-motion.mjs",
    "validate:proof": "node tooling/validators/validate-public-proof.mjs",
    "validate:proof:live": "node tooling/validators/validate-public-proof-live.mjs",
    "migration:report": "node tooling/migration/report.mjs",
    "build:foundry": "node tooling/foundry/build.mjs && node tooling/foundry/assemble-component-previews.mjs && node tooling/foundry/assemble-soft-dark.mjs && node tooling/foundry/assemble-rivet-dark.mjs && node tooling/foundry/assemble-mono-dark.mjs && node tooling/foundry/assemble-pulse-dark.mjs",
    "serve:foundry": "node tooling/foundry/serve.mjs",
    "build:studio": "node tooling/studio/build.mjs",
    "serve:studio": "node tooling/studio/serve.mjs",
    "test:studio": "playwright test --config=playwright.studio.config.mjs",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "quality": "npm run validate:foundation && npm run validate:spec && npm run validate:schemas && npm run validate:component-preview-contract && npm run validate:studio-contract && npm run validate:studio-theme-package && npm run validate:studio-runtime && npm run validate:migration && npm run validate:tokens && npm run validate:components && npm run validate:resolution && npm run validate:accessibility && npm run validate:proof && npm run build:foundry && npm run build:studio",
    "validate:pulse": "node tooling/validators/validate-pulse-theme.mjs",
    "validate:pulse-dark": "node tooling/validators/validate-pulse-dark-theme.mjs",
    "validate:pulse-proof": "node tooling/validators/validate-pulse-proof.mjs",
    "quality:restore": "node tooling/recovery/verify-restore.mjs",
    "validate:commerce": "node tooling/commerce/validate.mjs",
    "build:commerce": "node tooling/commerce/build.mjs",
    "test:commerce": "playwright test --config=playwright.commerce.config.mjs",
    "quality:commerce": "npm run validate:commerce && npm run build:commerce && npm run test:commerce",
    "validate:operations": "node tooling/operations/validate.mjs",
    "build:operations": "node tooling/operations/build.mjs",
    "test:operations": "playwright test --config=playwright.operations.config.mjs",
    "quality:operations": "npm run validate:operations && npm run build:operations && npm run test:operations",
    "validate:blocks": "node tooling/blocks/validate.mjs",
    "build:blocks": "node tooling/blocks/build.mjs",
    "test:blocks": "playwright test --config=playwright.blocks.config.mjs",
    "quality:blocks": "npm run validate:blocks && npm run build:blocks && npm run test:blocks",
    "build:library:local": "node tooling/ecosystem/package.mjs",
    "build:ecosystem:local": "node tooling/ecosystem/local.mjs",
    "validate:ecosystem": "node tooling/ecosystem/validate.mjs",
    "test:ecosystem": "playwright test --config=playwright.ecosystem.config.mjs",
    "gate:public": "node tooling/ecosystem/release-gate.mjs --public",
    "validate:license": "node tooling/ecosystem/check-license.mjs",
    "test:license": "node tooling/ecosystem/test-license.mjs",
    "validate:package-dryrun": "node tooling/ecosystem/validate-package-dryrun.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  },
  "license": "Apache-2.0"
}
