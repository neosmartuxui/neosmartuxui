{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartuxui.com/schemas/deployment-record@1.json",
  "title": "NeoSmartUXUI Deployment Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sourceRepository", "sourceSha", "artifact"],
  "properties": {
    "schema": {"const": "neosmartuxui/deployment-record@1"},
    "sourceRepository": {"const": "neosmartuxui/neosmartuxui"},
    "sourceSha": {"anyOf": [{"pattern": "^[0-9a-f]{40}$"}, {"const": "local-unpinned"}]},
    "artifact": {"enum": ["foundry", "studio"]}
  }
}
