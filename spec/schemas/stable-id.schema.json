{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartui.com/schemas/stable-id@1.json",
  "title": "NeoSmartUI Stable Semantic ID",
  "description": "A stable NeoSmartUI semantic identity. Layer-specific schemas narrow this further.",
  "type": "string",
  "oneOf": [
    {"pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"},
    {"pattern": "^[a-z][a-z0-9-]*\\.block\\.[a-z][a-z0-9-]*$"},
    {"pattern": "^[a-z][a-z0-9-]*\\.page\\.[a-z][a-z0-9-]*$"},
    {"pattern": "^flavor\\.[a-z][a-z0-9-]*$"},
    {"pattern": "^vertical\\.[a-z][a-z0-9-]*$"}
  ]
}
