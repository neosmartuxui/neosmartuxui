{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartui.com/schemas/component@1.json",
  "title": "NeoSmartUI Component Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "layer", "domain", "intent", "states", "dependencies", "supports"],
  "properties": {
    "schema": {"const": "neosmartui/component@1"},
    "id": {"type": "string", "pattern": "^(?!flavor\\.|vertical\\.)[a-z][a-z0-9-]*\\.(?!block\\.|page\\.)[a-z][a-z0-9-]*$"},
    "layer": {"const": "component"},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "intent": {"type": "string", "minLength": 1},
    "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "supports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyboard", "touch", "rtl", "reducedMotion", "forcedColors"],
      "properties": {
        "keyboard": {"type": "boolean"},
        "touch": {"type": "boolean"},
        "rtl": {"type": "boolean"},
        "reducedMotion": {"type": "boolean"},
        "forcedColors": {"type": "boolean"}
      }
    }
  }
}
