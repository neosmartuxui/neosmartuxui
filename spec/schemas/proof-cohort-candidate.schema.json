{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartuxui.github.io/schemas/proof-cohort-candidate@1.json",
  "title": "NeoSmartUXUI Current-Host Proof Cohort Candidate",
  "description": "An auditable but unverified migration candidate. It never confers public-proof maturity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "source", "oldHost", "proposedHost", "evidence", "counts", "subjects", "flavorReconciliations", "readyForPublicProof", "nextGate"],
  "properties": {
    "schema": {"const": "neosmartuxui/proof-cohort-candidate@1"},
    "status": {"const": "UNVERIFIED-CANDIDATE-NOT-PUBLIC-PROOF"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "sha", "originMain", "mergedAndClean"],
      "properties": {
        "repository": {"const": "neosmartuxui/neosmartuxui"},
        "sha": {"$ref": "#/$defs/sha"},
        "originMain": {"$ref": "#/$defs/sha"},
        "mergedAndClean": {"type": "boolean"}
      }
    },
    "oldHost": {"const": "https://neosmartui.github.io/"},
    "proposedHost": {"const": "https://neosmartuxui.github.io/foundry/"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["historicProofRecords", "browserReportSha256", "browserReportSourceShaVerified", "browserReportReasons", "cohortBrowserCoverageComplete", "cohortDigest"],
      "properties": {
        "historicProofRecords": {"const": 54},
        "browserReportSha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "browserReportSourceShaVerified": {"const": false},
        "browserReportReasons": {"type": "array", "items": {"type": "string"}},
        "cohortBrowserCoverageComplete": {"type": "boolean"},
        "cohortDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["core", "flavors", "total", "classifications"],
      "properties": {
        "core": {"const": 49}, "flavors": {"const": 5}, "total": {"const": 54},
        "classifications": {
          "type": "object", "additionalProperties": false,
          "required": ["unchanged", "maintenance-declared-theme-expansion", "verified-brand-host-migration"],
          "properties": {
            "unchanged": {"type": "integer", "minimum": 1},
            "maintenance-declared-theme-expansion": {"const": 20},
            "verified-brand-host-migration": {"const": 10}
          }
        }
      }
    },
    "subjects": {
      "type": "array", "minItems": 54, "maxItems": 54,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "historical", "bindings", "browserCoverage"],
        "properties": {
          "id": {"type": "string", "pattern": "^(core|flavor)\\.[a-z][a-z0-9-]*$"},
          "kind": {"enum": ["core", "flavor"]},
          "historical": {
            "type": "object", "additionalProperties": false,
            "required": ["recordPath", "recordBlobSha", "sourceSha", "oldDeploymentSha"],
            "properties": {
              "recordPath": {"type": "string", "pattern": "^evidence/public/(core|flavor)\\.[a-z0-9-]+\\.json$"},
              "recordBlobSha": {"$ref": "#/$defs/sha"},
              "sourceSha": {"$ref": "#/$defs/sha"},
              "oldDeploymentSha": {"$ref": "#/$defs/sha"}
            }
          },
          "bindings": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "historicalBlobSha", "currentBlobSha", "admission", "classification"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "historicalBlobSha": {"$ref": "#/$defs/sha"},
                "currentBlobSha": {"$ref": "#/$defs/sha"},
                "admission": {"enum": ["REFERENCE", "ADAPT"]},
                "classification": {"enum": ["unchanged", "maintenance-declared-theme-expansion", "verified-brand-host-migration"]},
                "priorBlobContentAvailable": {"type": "boolean"},
                "assurance": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "browserCoverage": {"type": "object", "required": ["id", "passed"], "properties": {
            "id": {"type": "string"},
            "passed": {"type": "boolean"}
          }}
        }
      }
    },
    "flavorReconciliations": {"type": "array", "minItems": 5, "maxItems": 5,
      "items": {"type": "object", "required": ["subject", "historicalAnchor", "declaredMaintenance", "verifiedRebrandPaths", "priorThemeBytesUnverified", "decision", "verificationRequired"],
        "properties": {
          "subject": {"type": "string", "pattern": "^flavor\\.[a-z-]+$"},
          "historicalAnchor": {"$ref": "#/$defs/sha"},
          "declaredMaintenance": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
          "verifiedRebrandPaths": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
          "priorThemeBytesUnverified": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
          "decision": {"const": "ADAPT"},
          "verificationRequired": {"type": "array", "items": {"type": "string"}}
        }, "additionalProperties": false}
    },
    "readyForPublicProof": {"const": false},
    "nextGate": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
