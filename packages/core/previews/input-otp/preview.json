    "partial": { "mode": "controller", "target": "#input-otp-demo" },
    "complete": { "mode": "controller", "target": "#input-otp-demo" },
    "invalid": { "mode": "controller", "target": "#input-otp-demo" },
    "disabled": { "mode": "controller", "target": "#input-otp-demo" }
  },
  "renderers": {
    "web": {
      "styles": ["packages/adapters/web/components/input-otp.css"],
      "bindings": [{
        "module": "packages/adapters/web/components/input-otp.mjs",
        "export": "bindInputOtp",
