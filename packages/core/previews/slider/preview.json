{
  "$schema": "../../../../spec/schemas/component-preview.schema.json",
  "schema": "neosmartuxui/component-preview@1",
  "component": "core.slider",
  "fixture": "fixture.html",
  "controller": "controller.mjs",
  "fixtureComponents": [],
  "defaultState": "rest",
  "resetStrategy": "remount",
  "stateRealization": {
    "rest": { "mode": "fixture", "target": "#slider-demo" },
    "hover": { "mode": "native-pointer", "target": "#slider-input" },
    "focus-visible": { "mode": "native-keyboard", "target": "#slider-input" },
    "pressed": { "mode": "native-pointer", "target": "#slider-input" },
    "disabled": { "mode": "controller", "target": "#slider-demo" }
  },
  "renderers": {
    "web": {
      "styles": ["packages/adapters/web/components/slider.css"],
      "bindings": [
        {
          "module": "packages/adapters/web/components/slider.mjs",
          "export": "bindSlider",
          "selector": "#slider-demo"
        },
        {
          "module": "packages/adapters/web/components/slider.mjs",
          "export": "bindSlider",
          "selector": "#slider-range-demo"
        }
      ]
    }
  }
}
