{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.time-picker",
  "layer": "component",
  "domain": "core",
  "intent": "Enter or select one local wall-clock time value with optional bounds and step granularity while preserving platform time-input semantics.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "empty",
    "filled",
    "invalid",
    "read-only",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.weight.regular"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
