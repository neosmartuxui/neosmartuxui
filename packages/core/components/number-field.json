{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.number-field",
  "intent": "Edit a bounded or unbounded numeric value with direct text entry and optional increment/decrement actions while retaining numeric form semantics.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "pressed",
    "empty",
    "filled",
    "invalid",
    "read-only",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body"
  ],
  "layer": "component",
  "domain": "core",
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
