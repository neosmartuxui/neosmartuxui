{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.hover-card",
  "layer": "component",
  "domain": "core",
  "intent": "Reveal structured non-interactive supplemental preview content from pointer hover or keyboard focus after a controlled delay, while preserving ordinary document interaction and avoiding Tooltip, Popover, menu, navigation, or business-domain semantics.",
  "states": [
    "closed",
    "open",
    "dismissed"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.content.primary",
    "color.content.secondary",
    "color.border.strong",
    "space.surface.inline",
    "space.surface.block",
    "border.surface.width",
    "radius.surface",
    "depth.rest.x",
    "depth.rest.y",
    "motion.standard.duration",
    "motion.standard.easing",
    "font.family.body",
    "font.size.body",
    "font.size.label",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
