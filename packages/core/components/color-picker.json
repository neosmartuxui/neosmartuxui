{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.color-picker",
  "layer": "component",
  "domain": "core",
  "intent": "Select one opaque color value through a platform color-selection control or accessibility-equivalent picker while exposing an explicit committed value.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "pressed",
    "selected",
    "invalid",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "motion.standard.duration",
    "motion.standard.easing"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
