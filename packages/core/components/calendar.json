{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.calendar",
  "layer": "component",
  "domain": "core",
  "intent": "Display and navigate a calendar grid for one-date or bounded-range selection with explicit current, selected and unavailable day semantics.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "pressed",
    "current",
    "selected",
    "range-start",
    "range-middle",
    "range-end",
    "unavailable",
    "disabled"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "space.surface.inline",
    "space.surface.block",
    "space.navigation.gap",
    "border.control.width",
    "border.surface.width",
    "radius.control",
    "radius.surface",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.size.label",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
