{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.dropdown-menu",
  "layer": "component",
  "domain": "core",
  "intent": "Present an explicitly invoked anchored menu of domain-free actions or commands from a menu button with deterministic composite keyboard navigation and dismissal, without becoming generic Popover, ContextMenu, Menubar, NavigationMenu, value-selection, or business-command authority.",
  "states": [
    "closed",
    "open",
    "hover",
    "focus-visible",
    "pressed",
    "checked",
    "disabled"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "space.surface.inline",
    "space.surface.block",
    "border.surface.width",
    "radius.control",
    "radius.surface",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.size.label",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
