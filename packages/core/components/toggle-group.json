{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.toggle-group",
  "intent": "Coordinate a named set of Toggle controls with explicit single- or multiple-selection policy while preserving each item's pressed-state semantics.",
  "states": [
    "rest",
    "none-selected",
    "selected",
    "disabled"
  ],
  "dependencies": [
    "space.control.inline",
    "space.control.block",
    "color.focus.ring",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled"
  ],
  "layer": "component",
  "domain": "core",
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
