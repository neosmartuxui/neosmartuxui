{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.input-group",
  "intent": "Compose one primary text-entry control with generic leading or trailing adornments and actions while preserving the primary control as the semantic authority.",
  "states": [
    "rest",
    "focus-within",
    "invalid",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "motion.standard.duration",
    "motion.standard.easing"
  ],
  "layer": "component",
  "domain": "core",
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
