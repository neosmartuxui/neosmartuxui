{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.toast",
  "layer": "component",
  "domain": "core",
  "intent": "Present transient queued status announcements without blocking interaction, stealing focus, becoming stable inline Alert content, or acquiring dialog, popover, menu, routing, business, network, or form authority.",
  "states": [
    "queued",
    "visible",
    "dismissed"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.strong",
    "color.state.info",
    "color.state.success",
    "color.state.warning",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "space.surface.inline",
    "space.surface.block",
    "size.control.minimum",
    "border.control.width",
    "border.surface.width",
    "radius.control",
    "radius.surface",
    "focus.ring.width",
    "focus.ring.offset",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.release.duration",
    "motion.standard.duration",
    "motion.press.easing",
    "motion.release.easing",
    "motion.standard.easing",
    "font.family.body",
    "font.size.body",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
