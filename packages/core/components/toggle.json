{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.toggle",
  "intent": "Represent one independent pressed or unpressed option whose state persists after activation and is distinct from an immediate-setting Switch.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "pressed",
    "off",
    "on",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.border.strong",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.label",
    "font.weight.emphasis"
  ],
  "layer": "component",
  "domain": "core",
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
