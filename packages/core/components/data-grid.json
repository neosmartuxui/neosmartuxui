{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.data-grid",
  "layer": "component",
  "domain": "core",
  "intent": "Navigate, optionally select, and explicitly enter editing within interactive tabular data through one managed grid focus model without acquiring sorting, filtering, pagination, virtualization, hierarchy, persistence, network, or business-data authority.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "selected",
    "editing"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "space.surface.inline",
    "space.surface.block",
    "size.control.minimum",
    "border.control.width",
    "border.surface.width",
    "focus.ring.width",
    "focus.ring.offset",
    "font.family.body",
    "font.size.body",
    "font.weight.regular",
    "font.weight.emphasis",
    "font.weight.strong"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
