{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.progress",
  "intent": "Expose completion of a task as a determinate value or an explicitly indeterminate progress state without implying user control.",
  "states": [
    "rest",
    "determinate",
    "indeterminate",
    "complete"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.action.primary.surface",
    "color.border.default",
    "border.control.width",
    "radius.control",
    "motion.standard.duration",
    "motion.standard.easing"
  ],
  "layer": "component",
  "domain": "core",
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
