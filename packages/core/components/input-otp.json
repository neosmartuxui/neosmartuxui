{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.input-otp",
  "layer": "component",
  "domain": "core",
  "intent": "Accept a fixed-length one-time code as one logical value while supporting paste, autocomplete and segmented presentation without fragmenting form authority.",
  "states": [
    "rest",
    "hover",
    "focus-visible",
    "empty",
    "partial",
    "complete",
    "invalid",
    "disabled"
  ],
  "dependencies": [
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "color.state.error",
    "color.focus.ring",
    "space.control.inline",
    "space.control.block",
    "border.control.width",
    "radius.control",
    "size.control.minimum",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "opacity.disabled",
    "font.family.body",
    "font.size.body",
    "font.weight.regular"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
