{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.dialog",
  "layer": "component",
  "domain": "core",
  "intent": "Present an application-modal content surface that temporarily contains focus and interaction until dismissed or completed, without adding alert-confirmation semantics or business-domain policy.",
  "states": [
    "closed",
    "open"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.content.primary",
    "color.content.secondary",
    "color.border.strong",
    "color.focus.ring",
    "space.surface.inline",
    "space.surface.block",
    "border.surface.width",
    "radius.surface",
    "depth.rest.x",
    "depth.rest.y",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "font.family.body",
    "font.size.body",
    "font.size.label",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
