{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartui/component@1",
  "id": "core.table",
  "layer": "component",
  "domain": "core",
  "intent": "Present static or read-only tabular data with native row/column relationships and header associations without acquiring grid, sorting, selection, editing, pagination, filtering, virtualization, or business-data authority.",
  "states": [
    "rest"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "color.border.strong",
    "space.surface.inline",
    "space.surface.block",
    "border.surface.width",
    "font.family.body",
    "font.size.body",
    "font.weight.regular",
    "font.weight.strong"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
