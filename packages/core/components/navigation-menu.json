{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.navigation-menu",
  "layer": "component",
  "domain": "core",
  "intent": "Present a named site/application navigation hierarchy with native destination links, optional first-level disclosure controls, current-route semantics, and ordinary document focus traversal without becoming Menubar, DropdownMenu, ContextMenu, generic Popover, Tabs, Breadcrumb, Pagination, Drawer, or routing/history authority.",
  "states": [
    "closed",
    "open",
    "hover",
    "focus-visible",
    "pressed",
    "current"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.surface.interactive",
    "color.content.primary",
    "color.content.secondary",
    "color.border.strong",
    "color.action.primary.surface",
    "color.action.primary.content",
    "color.focus.ring",
    "space.navigation.gap",
    "space.control.inline",
    "space.control.block",
    "space.surface.inline",
    "space.surface.block",
    "border.control.width",
    "border.surface.width",
    "radius.control",
    "radius.surface",
    "size.control.minimum",
    "depth.rest.x",
    "depth.rest.y",
    "depth.hover.x",
    "depth.hover.y",
    "depth.active.x",
    "depth.active.y",
    "press.hover.x",
    "press.hover.y",
    "press.active.x",
    "press.active.y",
    "motion.press.duration",
    "motion.press.easing",
    "motion.release.duration",
    "motion.release.easing",
    "motion.standard.duration",
    "motion.standard.easing",
    "focus.ring.width",
    "focus.ring.offset",
    "font.family.body",
    "font.size.body",
    "font.size.navigation",
    "font.weight.regular",
    "font.weight.emphasis"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
