{
  "$schema": "../../../spec/schemas/component.schema.json",
  "schema": "neosmartuxui/component@1",
  "id": "core.item",
  "layer": "component",
  "domain": "core",
  "intent": "Present one reusable structured content row or unit with optional leading, primary, supporting, metadata, trailing and action regions without acquiring collection, selection, navigation, activation, disclosure, editing, persistence, network, or business authority.",
  "states": [
    "rest"
  ],
  "dependencies": [
    "color.surface.panel",
    "color.content.primary",
    "color.content.secondary",
    "color.border.default",
    "space.surface.inline",
    "space.surface.block",
    "border.surface.width",
    "font.family.body",
    "font.size.body",
    "font.weight.regular",
    "font.weight.strong"
  ],
  "supports": {
    "keyboard": true,
    "touch": true,
    "rtl": true,
    "reducedMotion": true,
    "forcedColors": true
  }
}
